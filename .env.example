# Modelo de ambiente — fkx (template versionável; nunca commit .env real)
FKX_ENV=dev
FKX_LOG_LEVEL=INFO
# FKX_API_SECRET=troque-por-segredo-local (descomentado só em .env local)

# --- 015 docker-compose (molde copiavel: cp .env.example .env && chmod 600 .env) ---
# Gere segredos com: openssl rand -hex 32 (senhas: hex, sem caractere de URL)
# .env real NUNCA entra no indice (Lei Zero); este arquivo so tem placeholders.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
FKX_DB_PASSWORD=troque-por-hex-local-fkx
LANGFUSE_DB_PASSWORD=troque-por-hex-local-langfuse
REDIS_AUTH=troque-por-segredo-local-redis
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=troque-por-segredo-local-clickhouse
MINIO_ROOT_USER=troque-por-usuario-local-minio
MINIO_ROOT_PASSWORD=troque-por-segredo-local-minio
NEXTAUTH_SECRET=troque-por-segredo-local-nextauth
SALT=troque-por-segredo-local-sal
ENCRYPTION_KEY="troque-por-64-hex-local"
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=troque-por-segredo-local-grafana
